          "help": {
            "fr": "Choisissez la situation principale de l'enquêté.",
            "ar": "اختر الوضعية الرئيسية للمستجوب."
          }
        },
        {
          "id": "q_6",
          "type": "dropdown",
          "label": {
            "fr": "Quel est votre statut professionnel ?",
            "ar": "ما هي وضعيتك المهنية؟"
