          ],
          "help": {
            "fr": "Sélectionnez toutes les options qui s'appliquent.",
            "ar": "اختر جميع الإجابات المناسبة."
          }
        },
        {
          "id": "q_9",
          "type": "number",
          "label": {
            "fr": "Quel est votre salaire mensuel net ?",
            "ar": "ما هو راتبك الشهري الصافي؟"
          },
          "required": true,
          "validation": {
            "min": 0
          },
          "help": {
            "fr": "Saisissez le montant net en Dirhams (DH).",
            "ar": "أدخل المبلغ الصافي بالدرهم المغربي."
          }
        },
        {
          "id": "q_10",
          "type": "radio",
          "label": {
            "fr": "Avez-vous suivi une formation professionnelle au cours des 12 derniers mois ?",
            "ar": "هل تابعت تكويناً مهنياً خلال الـ 12 شهراً الماضية؟"
          },
          "required": true,
          "options": [
            {
              "value": "oui",
              "label": {
                "fr": "Oui",
                "ar": "نعم"
              }
            },
            {
              "value": "non",
              "label": {
                "fr": "Non",
                "ar": "لا"
              }
            }
          ],
          "help": {
            "fr": "Concerne toute formation qualifiante ou diplômante.",
            "ar": "يشمل أي تكوين مؤهل أو متوج بشهادة."
          }
