          "required": false,
          "options": [
            {
              "value": "independant",
              "label": {
                "fr": "Indépendant / À son propre compte",
                "ar": "مستقل / لحسابه الخاص"
              }
            },
            {
              "value": "salarie_public",
              "label": {
                "fr": "Salarié du secteur public",
                "ar": "مأجور في القطاع العمومي"
              }
            },
            {
              "value": "salarie_prive",
              "label": {
                "fr": "Salarié du secteur privé",
                "ar": "مأجور في القطاع الخاص"
              }
            },
            {
              "value": "aide_familial",
              "label": {
                "fr": "Aide familial",
                "ar": "مساعد عائلي"
              }
            },
            {
              "value": "employeur",
              "label": {
                "fr": "Employeur",
                "ar": "مشغِّل"
              }
            }
          ],
          "help": {
            "fr": "À remplir uniquement si la personne travaille.",
            "ar": "يملأ فقط إذا كان الشخص يشتغل."
          }
        },
        {
          "id": "q_7",
          "type": "number",
          "label": {
            "fr": "Combien d'heures travaillez-vous par semaine en moyenne ?",
            "ar": "كم عدد الساعات التي تشتغلها في الأسبوع في المتوسط؟"
