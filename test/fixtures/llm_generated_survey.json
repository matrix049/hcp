{
  "id": "survey_emploi_jeunes_2026",
  "version": 1,
  "title": {
    "fr": "Enquête Emploi Jeunes 2026",
    "ar": "بحث التشغيل لدى الشباب 2026"
  },
  "locales": [
    "fr",
    "ar"
  ],
  "pages": [
    {
      "id": "page_1",
      "title": {
        "fr": "Enquête Emploi Jeunes 2026",
        "ar": "بحث التشغيل لدى الشباب 2026"
      },
      "questions": [
        {
          "id": "q_1",
          "type": "dropdown",
          "label": {
            "fr": "Quel est votre niveau d'études le plus élevé ?",
            "ar": "ما هو أعلى مستوى دراسي بلغته؟"
          },
          "required": true,
          "options": [
            {
              "value": "sans_diplome",
              "label": {
                "fr": "Sans diplôme",
                "ar": "بدون شهادة"
              }
            },
            {
              "value": "primaire",
              "label": {
                "fr": "Enseignement primaire",
                "ar": "التعليم الابتدائي"
              }
            },
            {
              "value": "secondaire_collegial",
              "label": {
                "fr": "Enseignement secondaire collégial",
                "ar": "التعليم الثانوي الإعدادي"
              }
            },
            {
              "value": "secondaire_qualifiant",
              "label": {
                "fr": "Enseignement secondaire qualifiant",
                "ar": "التعليم الثانوي التأهيلي"
              }
            },
            {
              "value": "superieur",
              "label": {
                "fr": "Enseignement supérieur",
                "ar": "التعليم العالي"
              }
            }
          ],
          "help": {
            "fr": "Sélectionnez le dernier niveau d'études validé.",
            "ar": "اختر آخر مستوى دراسي تم إكماله بنجاح."
          }
        },
        {
          "id": "q_2",
          "type": "number",
          "label": {
            "fr": "Depuis combien de mois cherchez-vous un emploi ?",
            "ar": "منذ كم من شهر وأنت تبحث عن عمل؟"
          },
          "required": true,
          "validation": {
            "min": 0
          },
          "help": {
            "fr": "Saisissez le nombre de mois. Indiquez 0 si moins d'un mois.",
            "ar": "أدخل عدد الأشهر. اكتب 0 إذا كان أقل من شهر."
          }
        },
        {
          "id": "q_3",
          "type": "date",
          "label": {
            "fr": "Date de naissance",
            "ar": "تاريخ الازدياد"
          },
          "required": true,
          "help": {
            "fr": "Saisissez la date de naissance exacte selon la CIN ou l'acte de naissance.",
            "ar": "أدخل تاريخ الازدياد بدقة حسب البطاقة الوطنية أو عقد الازدياد."
          }
        },
        {
          "id": "q_4",
          "type": "radio",
          "label": {
            "fr": "Êtes-vous actuellement inscrit à l'ANAPEC ?",
            "ar": "هل أنت مسجل حالياً في الوكالة الوطنية لإنعاش التشغيل والكفاءات؟"
          },
          "required": true,
          "options": [
            {
              "value": "oui",
              "label": {
                "fr": "Oui",
                "ar": "نعم"
              }
            },
            {
              "value": "non",
              "label": {
                "fr": "Non",
                "ar": "لا"
              }
            }
          ],
          "help": {
            "fr": "Vérifiez si l'inscription est toujours active.",
            "ar": "تحقق مما إذا كان التسجيل لا يزال نشطاً."
          }
        },
        {
          "id": "q_5",
          "type": "dropdown",
          "label": {
            "fr": "Quelle est votre situation actuelle vis-à-vis de l'emploi ?",
            "ar": "ما هي وضعيتك الحالية تجاه التشغيل؟"
