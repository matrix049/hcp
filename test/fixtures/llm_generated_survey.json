          "required": true,
          "validation": {
            "min": 0
          },
          "help": {
            "fr": "Indiquez le nombre moyen d'heures par semaine.",
            "ar": "أدخل متوسط عدد الساعات في الأسبوع."
          }
        },
        {
          "id": "q_8",
          "type": "checkbox",
          "label": {
            "fr": "Quels moyens utilisez-vous pour chercher un emploi ?",
            "ar": "ما هي الوسائل التي تستعملها للبحث عن عمل؟"
          },
          "required": true,
          "options": [
            {
              "value": "anapec",
              "label": {
                "fr": "Inscription à l'ANAPEC",
                "ar": "التسجيل في الوكالة الوطنية لإنعاش التشغيل والكفاءات"
              }
            },
            {
              "value": "concours",
              "label": {
                "fr": "Concours de la fonction publique",
                "ar": "مباريات الوظيفة العمومية"
              }
            },
            {
              "value": "candidature_directe",
              "label": {
                "fr": "Candidatures directes auprès des employeurs",
                "ar": "طلبات مباشرة للمشغلين"
              }
            },
            {
              "value": "reseau_personnel",
              "label": {
                "fr": "Réseau personnel et familial",
                "ar": "شبكة العلاقات الشخصية والعائلية"
              }
            },
            {
              "value": "internet",
              "label": {
                "fr": "Internet et réseaux sociaux",
                "ar": "الإنترنت وشبكات التواصل الاجتماعي"
              }
            },
            {
              "value": "autre",
              "label": {
                "fr": "Autre moyen",
                "ar": "وسيلة أخرى"
              }
