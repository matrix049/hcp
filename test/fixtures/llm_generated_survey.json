          "required": true,
          "multiline": true,
          "help": {
            "fr": "Laissez l'enquêté s'exprimer librement sur ses obstacles.",
            "ar": "اترك المستجوب يعبر بحرية عن العقبات التي تواجهه."
          }
        },
        {
          "id": "q_14",
          "type": "text",
          "label": {
            "fr": "Commentaires libres",
            "ar": "تعليقات حرة"
          },
          "required": false,
          "multiline": true,
          "help": {
            "fr": "Zone de texte pour toute remarque additionnelle.",
            "ar": "مساحة مخصصة لأي ملاحظات إضافية."
          }
        }
