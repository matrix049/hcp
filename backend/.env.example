# --- Serveur ---
PORT=3000

# --- Base de données ---
DATABASE_URL=postgres://hcp:hcp_dev_password@localhost:5432/hcp_survey

# --- Jetons JWT ---
# OBLIGATOIRE. Générer une valeur unique par environnement :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacez_par_une_valeur_aleatoire
JWT_ACCESS_EXPIRES=12h
JWT_REFRESH_EXPIRES=30d

# --- Compte administrateur ---
# OBLIGATOIRES : le serveur refuse de démarrer sans elles (aucune valeur par
# défaut dans le code source — un mot de passe par défaut est un mot de passe public).
ADMIN_EMAIL=hcp@admin.com
ADMIN_PASSWORD=remplacez_par_un_mot_de_passe_fort

# --- Sécurité HTTP ---
# Origines autorisées, séparées par des virgules. Vide = ouvert (développement).
CORS_ORIGINS=
LOGIN_WINDOW_MS=60000
LOGIN_MAX_ATTEMPTS=10

# --- Génération de questionnaires par IA ---
# Facultatif : sans clé, la génération retombe sur les règles par mots-clés.
# Clé gratuite : https://aistudio.google.com  ->  Get API key
GOOGLE_API_KEY=
LLM_ENABLED=true
LLM_TIMEOUT_MS=120000
LLM_MAX_ATTEMPTS=2
LLM_DEADLINE_MS=150000
LLM_STALL_MS=25000
