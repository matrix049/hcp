        {
          "id": "q_11",
          "type": "checkbox",
          "label": {
            "fr": "Dans quels domaines souhaiteriez-vous vous former ?",
            "ar": "ما هي المجالات التي ترغب في التكون فيها؟"
          },
          "required": true,
          "options": [
            {
              "value": "informatique",
              "label": {
                "fr": "Informatique et digital",
                "ar": "المعلوميات والرقميات"
              }
            },
            {
              "value": "langues",
              "label": {
                "fr": "Langues étrangères",
                "ar": "اللغات الأجنبية"
              }
            },
            {
              "value": "gestion",
              "label": {
                "fr": "Gestion et entrepreneuriat",
                "ar": "التسيير وريادة الأعمال"
              }
            },
            {
              "value": "technique",
              "label": {
                "fr": "Métiers techniques et artisanat",
                "ar": "المهن التقنية والحرفية"
              }
            },
            {
              "value": "communication",
              "label": {
                "fr": "Communication et soft skills",
                "ar": "التواصل والمهارات الحياتية"
              }
            },
            {
              "value": "autre",
              "label": {
                "fr": "Autre domaine",
                "ar": "مجال آخر"
              }
            }
          ],
          "help": {
            "fr": "Sélectionnez un ou plusieurs domaines d'intérêt.",
            "ar": "اختر مجالاً واحداً أو أكثر من مجالات الاهتمام."
          }
        },
        {
          "id": "q_12",
          "type": "dropdown",
          "label": {
            "fr": "Quel est votre niveau en langues ?",
            "ar": "ما هو مستواك في اللغات؟"
          },
          "required": true,
          "options": [
            {
              "value": "debutant",
              "label": {
                "fr": "Débutant",
                "ar": "مبتدئ"
              }
            },
            {
              "value": "intermediaire",
              "label": {
                "fr": "Intermédiaire",
                "ar": "متوسط"
              }
            },
            {
              "value": "avance",
              "label": {
                "fr": "Avancé / Courant",
                "ar": "متقدم / بطلاقة"
              }
            }
          ],
          "help": {
            "fr": "Évaluez globalement le niveau en français et anglais.",
            "ar": "قم بتقييم المستوى العام في اللغتين الفرنسية والإنجليزية."
          }
        },
        {
          "id": "q_13",
          "type": "text",
          "label": {
            "fr": "Décrivez les principales difficultés que vous rencontrez dans votre recherche d'emploi.",
