          "required": true,
          "options": [
            {
              "value": "actif_occupe",
              "label": {
                "fr": "Actif occupé",
                "ar": "نشيط مشتغل"
              }
            },
            {
              "value": "chomeur",
              "label": {
                "fr": "Chômeur",
                "ar": "عاطل"
              }
            },
            {
              "value": "etudiant",
              "label": {
                "fr": "Étudiant ou stagiaire",
                "ar": "طالب أو متدرب"
              }
            },
            {
              "value": "foyer",
              "label": {
                "fr": "Au foyer",
                "ar": "رب(ة) بيت"
              }
            },
            {
              "value": "autre",
              "label": {
                "fr": "Autre inactif",
                "ar": "غير نشيط آخر"
              }
            }
